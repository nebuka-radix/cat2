#!/usr/bin/env python3
import os
import sys
from pathlib import Path
from pathlib import PurePosixPath
import re
from io import StringIO
import fnmatch


def get_next_output_number():
    """既存のoutput.XX.mdファイルから次の連番を取得"""
    pattern = re.compile(r'output\.(\d{2})\.md')
    max_num = 0
    
    for filename in os.listdir('.'):
        match = pattern.match(filename)
        if match:
            num = int(match.group(1))
            max_num = max(max_num, num)
    
    return max_num + 1


def is_text_file(filepath):
    """ファイルがテキストファイルかどうかを判定"""
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            f.read(512)  # 最初の512バイトを読んでみる
        return True
    except (UnicodeDecodeError, PermissionError):
        return False


def load_ignore_rules(ignore_file):
    """.cat2ignore (gitignore形式) を読み込む"""
    rules = []
    ignore_path = Path(ignore_file)

    if not ignore_path.is_file():
        return rules

    try:
        with open(ignore_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()
    except OSError as e:
        print(f"Warning: Could not read {ignore_file}: {e}", file=sys.stderr)
        return rules

    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith('#'):
            continue

        negated = line.startswith('!')
        if negated:
            line = line[1:]
            if not line:
                continue

        directory_only = line.endswith('/')
        if directory_only:
            line = line[:-1]

        anchored = line.startswith('/')
        if anchored:
            line = line[1:]

        if not line:
            continue

        rules.append(
            {
                'pattern': line,
                'negated': negated,
                'directory_only': directory_only,
                'anchored': anchored,
            }
        )

    return rules


def is_ignored(rel_path, is_dir, rules):
    """デフォルト除外と読み込んだルールに基づいて除外対象か判定"""
    # 過去の生成物を入力として取り込まない。
    if not is_dir and re.fullmatch(r"output\.\d{2,}\.md", rel_path.name):
        return True

    # 階層に関係なく node_modules ディレクトリを常に除外する
    if is_dir and rel_path.name == 'node_modules':
        return True

    if not rules:
        return False

    rel_posix = rel_path.as_posix()
    ignored = False

    for rule in rules:
        if rule['directory_only'] and not is_dir:
            continue

        pattern = rule['pattern']
        matched = False

        if '/' in pattern:
            if rule['anchored']:
                matched = PurePosixPath(rel_posix).match(pattern)
            else:
                matched = (
                    PurePosixPath(rel_posix).match(pattern)
                    or PurePosixPath(rel_posix).match(f"**/{pattern}")
                )
        else:
            matched = fnmatch.fnmatch(rel_path.name, pattern)

        if matched:
            ignored = not rule['negated']

    return ignored


def collect_files(directory, ignore_rules=None):
    """ディレクトリ内のすべてのファイルを収集"""
    files_content = []
    directory_path = Path(directory).resolve()
    ignore_rules = ignore_rules or []
    
    for root, dirs, files in os.walk(directory_path):
        root_path = Path(root)
        rel_root = root_path.relative_to(directory_path)

        # 隠しディレクトリをスキップ
        dirs[:] = [d for d in dirs if not d.startswith('.')]

        # .cat2ignore で除外対象のディレクトリをスキップ
        dirs[:] = [
            d
            for d in dirs
            if not is_ignored(rel_root / d, True, ignore_rules)
        ]
        
        for filename in sorted(files):
            # 隠しファイルをスキップ
            if filename.startswith('.'):
                continue

            if is_ignored(rel_root / filename, False, ignore_rules):
                continue
                
            filepath = root_path / filename
            relative_path = filepath.relative_to(directory_path)
            
            # テキストファイルのみ処理
            if is_text_file(filepath):
                try:
                    with open(filepath, 'r', encoding='utf-8') as f:
                        content = f.read()
                    files_content.append((str(relative_path), content))
                except Exception as e:
                    print(f"Warning: Could not read {relative_path}: {e}", file=sys.stderr)
    
    return files_content


def _tree_lines(directory, root_directory, prefix="", show_hidden=False, ignore_rules=None):
    """tree表示用の行を再帰的に生成"""
    ignore_rules = ignore_rules or []

    try:
        entries = sorted(directory.iterdir(), key=lambda x: (not x.is_dir(), x.name.lower()))
    except PermissionError:
        return

    if not show_hidden:
        entries = [e for e in entries if not e.name.startswith('.')]

    filtered_entries = []
    for entry in entries:
        rel_path = entry.relative_to(root_directory)
        if is_ignored(rel_path, entry.is_dir(), ignore_rules):
            continue
        filtered_entries.append(entry)

    entries = filtered_entries

    for i, entry in enumerate(entries):
        is_last_entry = (i == len(entries) - 1)

        if is_last_entry:
            current = "└── "
            extension = "    "
        else:
            current = "├── "
            extension = "│   "

        if entry.is_dir():
            yield f"{prefix}{current}{entry.name}/"
            yield from _tree_lines(
                entry,
                root_directory,
                prefix + extension,
                show_hidden,
                ignore_rules,
            )
        else:
            yield f"{prefix}{current}{entry.name}"


def _count_entries(directory, show_hidden=False, ignore_rules=None):
    """ディレクトリとファイル数をカウント"""
    dir_count = 0
    file_count = 0
    directory = Path(directory).resolve()
    ignore_rules = ignore_rules or []

    for root, dirs, files in os.walk(directory):
        root_path = Path(root)
        rel_root = root_path.relative_to(directory)

        if not show_hidden:
            dirs[:] = [d for d in dirs if not d.startswith('.')]
            files = [f for f in files if not f.startswith('.')]

        dirs[:] = [
            d
            for d in dirs
            if not is_ignored(rel_root / d, True, ignore_rules)
        ]
        files = [
            f
            for f in files
            if not is_ignored(rel_root / f, False, ignore_rules)
        ]

        dir_count += len(dirs)
        file_count += len(files)

    return dir_count, file_count


def get_tree_output(directory, show_hidden=False, ignore_rules=None):
    """treeコマンド相当の出力を文字列で取得"""
    directory = Path(directory).resolve()
    ignore_rules = ignore_rules or []
    if not directory.is_dir():
        return f"Error: {directory} is not a directory"

    out = StringIO()
    out.write(f"{directory.name if directory.name else '.'}\n")

    for line in _tree_lines(directory, directory, show_hidden=show_hidden, ignore_rules=ignore_rules):
        out.write(f"{line}\n")

    dir_count, file_count = _count_entries(directory, show_hidden, ignore_rules)
    out.write(f"\n{dir_count} directories, {file_count} files")

    return out.getvalue().rstrip('\n')


def generate_output(files_content, target_dir, ignore_rules=None):
    """ファイル内容を結合してマークダウン形式で出力"""
    output_lines = []
    ignore_rules = ignore_rules or []

    output_lines.append("````#file:tree")
    output_lines.append(get_tree_output(target_dir, ignore_rules=ignore_rules))
    output_lines.append("````")
    output_lines.append('')
    
    for filename, content in files_content:
        output_lines.append(f"````{filename}")
        output_lines.append(content)
        if not content.endswith('\n'):
            output_lines.append('')
        output_lines.append("````")
        output_lines.append('')
    
    return '\n'.join(output_lines)


def cleanup_output_files():
    """既存の output.??.md を削除"""
    pattern = re.compile(r'output\.\d{2}\.md')
    deleted_count = 0

    for path in Path('.').glob('output.??.md'):
        if path.is_file() and pattern.fullmatch(path.name):
            try:
                path.unlink()
                deleted_count += 1
            except OSError as e:
                print(f"Warning: Could not delete {path}: {e}", file=sys.stderr)

    return deleted_count

# --- Textual UI / token-based output ---
import tempfile
from dataclasses import dataclass

try:
    import tiktoken
    from InquirerPy import inquirer
    from InquirerPy.base.control import Choice
except ImportError as exc:
    raise SystemExit(
        "Required packages are missing.\n"
        "Run: python3 -m pip install -r cat2-requirements.txt\n"
        f"Details: {exc}"
    ) from exc


# ツール用の初期値。Gemini公式のモデル上限ではない。
ENGINE_PROFILES = {
    "flash": ("Gemini Flash", 32000),
    "thinking": ("Gemini Thinking", 32000),
    "pro": ("Gemini Pro", 64000),
}

# Geminiモデル指定と、計測用のOpenAIモデル指定は分離する。
TOKENIZERS = [
    ("gpt-4o / o200k_base", "model:gpt-4o"),
    ("gpt-4 / cl100k_base", "model:gpt-4"),
    ("encoding: o200k_base", "encoding:o200k_base"),
    ("encoding: cl100k_base", "encoding:cl100k_base"),
    ("encoding: p50k_base", "encoding:p50k_base"),
]

OUTPUT_PATTERN = re.compile(r"output\.\d{2,}\.md")


@dataclass(frozen=True)
class OutputPlan:
    directory: str
    engine: str
    tokenizer: str
    encoding: str
    limit: int
    documents: tuple
    counts: tuple
    file_count: int


def load_tokenizer(setting):
    kind, name = setting.split(":", 1)
    if kind == "model":
        return tiktoken.encoding_for_model(name)
    return tiktoken.get_encoding(name)


def count_tokens(encoding, text):
    # ソース中の特殊トークン風文字列も通常の文字列として扱う。
    return len(encoding.encode(text, disallowed_special=()))


def fenced_section(label, content):
    label = label.replace("\r", "\\r").replace("\n", "\\n")
    longest = max(
        (len(m.group(0)) for m in re.finditer(r"`+", content)),
        default=0,
    )
    fence = "`" * max(4, longest + 1)
    separator = "" if content.endswith("\n") else "\n"
    return f"{fence}{label}\n{content}{separator}{fence}\n\n"


def split_section(label, content, fits):
    """文字単位の分割で元データを保持し、完成したブロックを再計測する。"""
    whole = fenced_section(label, content)
    if fits(whole):
        return [whole]

    def divide(start, end):
        piece_label = f"{label} [chars {start}:{end}]"
        block = fenced_section(piece_label, content[start:end])
        if fits(block):
            return [block]
        if end - start <= 1:
            raise ValueError(
                f"The section cannot fit within the token limit: {label}"
            )

        midpoint = (start + end) // 2
        # 巨大な1行以外は、できるだけ行境界で分割する。
        newline = content.rfind("\n", start, midpoint)
        if newline >= start + (end - start) // 4:
            midpoint = newline + 1
        return divide(start, midpoint) + divide(midpoint, end)

    return divide(0, len(content))


def build_output_plan(directory, engine, tokenizer, limit):
    if limit < 1024:
        raise ValueError("The token limit must be at least 1,024.")

    target = Path(directory).expanduser().resolve()
    if not target.is_dir():
        raise ValueError(f"Directory not found: {target}")

    encoding = load_tokenizer(tokenizer)
    local_ignore = target / ".cat2ignore"
    ignore_file = (
        local_ignore if local_ignore.is_file() else Path(".cat2ignore")
    )
    rules = load_ignore_rules(ignore_file)
    files = collect_files(target, rules)

    if not files:
        raise ValueError("No text files were found.")

    engine_label = ENGINE_PROFILES[engine][0]
    header = (
        "# cat2 export\n\n"
        f"- Profile: {engine_label}\n"
        f"- Tokenizer: {tokenizer}\n"
        f"- Encoding: {encoding.name}\n"
        f"- Limit: {limit} estimated tokens per file\n"
        "- Counts are tiktoken estimates, not Gemini token counts.\n\n"
    )

    def fits(block):
        return count_tokens(encoding, header + block) <= limit

    sections = [
        ("#file:tree", get_tree_output(target, ignore_rules=rules))
    ]
    sections.extend(files)

    documents = []
    current = header

    for label, content in sections:
        for block in split_section(label, content, fits):
            candidate = current + block
            if count_tokens(encoding, candidate) > limit:
                if current == header:
                    raise ValueError("A single block exceeds the token limit.")
                documents.append(current)
                current = header + block
            else:
                current = candidate

    if current != header:
        documents.append(current)

    counts = tuple(count_tokens(encoding, doc) for doc in documents)
    if not all(count <= limit for count in counts):
        raise ValueError("Final output token validation failed.")

    return OutputPlan(
        directory=str(target),
        engine=engine,
        tokenizer=tokenizer,
        encoding=encoding.name,
        limit=limit,
        documents=tuple(documents),
        counts=counts,
        file_count=len(files),
    )


def write_output_plan(plan):
    """全ファイルを一時保存後に配置し、余った旧出力を削除する。"""
    destination = Path.cwd()
    encoding = load_tokenizer(plan.tokenizer)

    # 書き込み直前にも、実際の出力文字列を再計測する。
    actual = tuple(
        count_tokens(encoding, doc) for doc in plan.documents
    )
    if actual != plan.counts or any(n > plan.limit for n in actual):
        raise ValueError("Pre-export token validation failed.")

    names = [
        f"output.{number:02d}.md"
        for number in range(1, len(plan.documents) + 1)
    ]

    with tempfile.TemporaryDirectory(
        prefix=".cat2-stage-", dir=destination
    ) as temporary:
        stage = Path(temporary)
        for name, document in zip(names, plan.documents):
            (stage / name).write_bytes(document.encode("utf-8"))

        for name in names:
            (stage / name).replace(destination / name)

        expected = set(names)
        for path in destination.iterdir():
            if (
                OUTPUT_PATTERN.fullmatch(path.name)
                and path.name not in expected
                and (path.is_file() or path.is_symlink())
            ):
                path.unlink()

    return names












def select_console(message, choices, default):
    return inquirer.select(
        message=message,
        choices=[
            Choice(value=value, name=label)
            for label, value in choices
        ],
        default=default,
        instruction="(Up/Down to move, Enter to select)",
        raise_keyboard_interrupt=True,
    ).execute()


def print_output_summary(plan):
    print()
    print("Export preview")
    print("--------------")
    print(f"Source:           {plan.directory}")
    print(f"Profile:          {ENGINE_PROFILES[plan.engine][0]}")
    print(f"Tokenizer:        {plan.tokenizer}")
    print(f"Encoding:         {plan.encoding}")
    print(f"Input files:      {plan.file_count:,}")
    print(f"Token limit:      {plan.limit:,}")
    print(f"Output files:     {len(plan.documents):,}")
    print(f"Output directory: {Path.cwd()}")
    print()

    for number, (document, count) in enumerate(
        zip(plan.documents, plan.counts), 1
    ):
        size = len(document.encode("utf-8"))
        print(
            f"  output.{number:02d}.md"
            f"  {count:>9,} estimated tokens"
            f"  {size:>10,} bytes"
        )

    print()
    print("Token counts are tiktoken estimates, not Gemini token counts.")
    print("Export uses the source snapshot collected during this preview.")
    print("Run the preview again if the source files have changed.")
    print("Existing output.NN.md files in the output directory are replaced.")
    print()


def choose_token_limit(engine, current=None):
    default = ENGINE_PROFILES[engine][1]
    selected = default if current is None else current
    values = sorted({
        8000, 16000, 32000, 64000, 128000,
        default, selected,
    })

    choices = [
        (
            f"{value:,} tokens"
            + (" (profile default)" if value == default else ""),
            value,
        )
        for value in values
    ]
    choices.append(("Custom limit...", "custom"))

    result = select_console(
        "Select the token limit:",
        choices,
        selected,
    )
    if result != "custom":
        return result

    def valid_limit(value):
        return value.isascii() and value.isdigit() and int(value) >= 1024

    value = inquirer.text(
        message="Enter a token limit:",
        default=str(selected),
        validate=valid_limit,
        invalid_message="Enter an integer of at least 1,024.",
        raise_keyboard_interrupt=True,
    ).execute()
    return int(value)


def run_console_wizard(initial_directory):
    directory = initial_directory

    while True:
        print()
        print("cat2 - Gemini Export")
        print("Use Up/Down and Enter to select. Press Ctrl+C to cancel.")
        print("Profile limits are local presets, not official Gemini limits.")
        print()

        directory = inquirer.filepath(
            message="Target directory:",
            default=directory,
            only_directories=True,
            validate=lambda value: bool(value.strip()) and (
                Path(value).expanduser().is_dir()
            ),
            invalid_message="Enter an existing directory.",
            raise_keyboard_interrupt=True,
        ).execute()
        directory = str(Path(directory).expanduser().resolve())

        engine = select_console(
            "Select a Gemini profile:",
            [
                (label, key)
                for key, (label, _) in ENGINE_PROFILES.items()
            ],
            "flash",
        )

        tokenizer = select_console(
            "Select a token counting model:",
            TOKENIZERS,
            "model:gpt-4o",
        )

        limit = choose_token_limit(engine)

        while True:
            print()
            print("Collecting files, counting tokens and splitting...")
            print(
                "The first tokenizer load may download encoding data."
            )

            try:
                plan = build_output_plan(
                    directory, engine, tokenizer, limit
                )
            except Exception as exc:
                print(f"\nError: {exc}\n")
                action = select_console(
                    "What would you like to do?",
                    [
                        ("Retry", "retry"),
                        ("Change token limit", "limit"),
                        ("Start over", "restart"),
                        ("Quit", "quit"),
                    ],
                    "retry",
                )
                if action == "quit":
                    return
                if action == "restart":
                    break
                if action == "limit":
                    limit = choose_token_limit(engine, limit)
                continue

            print_output_summary(plan)

            action = select_console(
                "What would you like to do?",
                [
                    ("Export files", "export"),
                    ("Run preview again", "retry"),
                    ("Change token limit", "limit"),
                    ("Start over", "restart"),
                    ("Quit without exporting", "quit"),
                ],
                "export",
            )

            if action == "quit":
                return
            if action == "restart":
                break
            if action == "limit":
                limit = choose_token_limit(engine, limit)
                continue
            if action == "retry":
                continue

            print()
            print("Rechecking token counts and exporting files...")

            try:
                names = write_output_plan(plan)
            except Exception as exc:
                print(f"\nExport failed: {exc}")
                print(
                    "Some files may have been written. "
                    "Inspect the output directory before retrying."
                )
                continue

            print(f"\nExport complete: {len(names):,} files")
            print(f"Output directory: {Path.cwd()}")
            for name in names:
                print(f"  {name}")
            print()

            action = select_console(
                "What would you like to do next?",
                [
                    ("Quit", "quit"),
                    ("Export another project", "restart"),
                ],
                "quit",
            )
            if action == "quit":
                return
            break


def main():
    if len(sys.argv) > 2:
        print("Usage: cat2 [directory]", file=sys.stderr)
        sys.exit(1)

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print(
            "Error: interactive input and output terminals are required.",
            file=sys.stderr,
        )
        sys.exit(1)

    directory = sys.argv[1] if len(sys.argv) == 2 else "."

    try:
        run_console_wizard(directory)
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")
        sys.exit(130)

if __name__ == "__main__":
    main()
